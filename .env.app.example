# Gahez Live app: copy to .env.app on the server and fill in. Never commit .env.app.
# Anything left empty switches that integration off (the app says so instead of failing).

# Database password (used by both containers; compose reads it via --env-file .env.app)
POSTGRES_PASSWORD=

# Public addresses
APP_URL=https://app.live.gahez.space
API_URL=https://app.live.gahez.space
CORS_ORIGINS=https://app.live.gahez.space

# Platform owners: these emails become admins when they sign up.
ADMIN_EMAILS=

# Money: platform share in basis points (1000 = 10%), and how long a lecture's
# earnings stay on hold after it ends (refund window).
PLATFORM_FEE_BPS=1000
PAYOUT_HOLD_HOURS=24

# Paymob (Egypt): dashboard → Developers. Integration ids are comma separated:
# card, mobile wallets, Apple Pay, Google Pay. Webhook ("transaction processed
# callback") URL: https://app.live.gahez.space/api/webhooks/paymob
PAYMENT_PROVIDER=paymob
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# LiveKit (Cloud or self-hosted). Webhook URL: https://app.live.gahez.space/api/webhooks/livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Recordings: an S3-compatible bucket (Cloudflare R2 recommended) and the public/CDN base it's served from.
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_BUCKET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_PUBLIC_BASE=

# Mail: the same Zoho mailbox as the marketing site.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gahez Live <support@gahez.space>
